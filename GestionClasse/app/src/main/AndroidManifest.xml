<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestionClasse">

        <activity
            android:name=".ui.RoleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ClasseActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />
        <activity
            android:name=".ui.EtudiantListActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />
        <activity
            android:name=".ui.EtudiantDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.EtudiantFormActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ConversationActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
